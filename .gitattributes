# Keep repository text files normalized for Linux-first operations.
* text=auto
.gitattributes text eol=lf

# Documentation and configuration examples should stay LF across platforms.
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env text eol=lf
*.example text eol=lf
*.service text eol=lf
*.Caddyfile text eol=lf
Caddyfile* text eol=lf
SKILL.md text eol=lf

# Runtime scripts used by these Linux-focused modules need LF.
*.sh text eol=lf
*.js text eol=lf

# If Windows-native scripts are added later, CRLF is usually friendlier.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
